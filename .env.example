# RCA agent configuration

# Provider: litellm | fake | anthropic | openai
RCA_PROVIDER=litellm

# Model name as registered on the LiteLLM proxy (or as the provider expects)
RCA_MODEL=

# LiteLLM proxy connection (used when RCA_PROVIDER=litellm)
RCA_MODEL_BASE_URL=http://localhost:4000
RCA_MODEL_API_KEY=

RCA_MODEL_TEMPERATURE=0.0
RCA_LOG_LEVEL=INFO
